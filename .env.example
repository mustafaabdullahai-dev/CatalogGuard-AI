# CatalogGuard AI — environment template
# Copy to .env and fill in real values. NEVER commit .env.
#
# D-010: telemetry must not leave our data perimeter. No LangSmith key here
# by design. Observability goes to self-hosted Langfuse only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=CatalogGuard AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (D-009: Neon hosted Postgres, pooled endpoint, TLS required)
# ---------------------------------------------------------------------------
# Replace with the ROTATED password. The original was exposed in plaintext.
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-dry-resonance-a5u9w8p1-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# D-006: pgvector must be enabled on this database.
# Verify with: CREATE EXTENSION IF NOT EXISTS vector;
ENABLE_PGVECTOR=true

# ---------------------------------------------------------------------------
# Redis / queue (D-008: Dramatiq)
# Upstash requires TLS: use the rediss:// scheme, NOT redis://.
# Verified live: Redis 8.4.0, standalone.
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:REPLACE_ME@REPLACE_ME.upstash.io:6379/0
DRAMATIQ_BROKER_URL=rediss://default:REPLACE_ME@REPLACE_ME.upstash.io:6379/1
DRAMATIQ_MAX_RETRIES=3
DRAMATIQ_CONCURRENCY=4
# D-007: free-tier Qroq will throttle. Keep concurrency low; queue rather than fail.
LLM_MAX_CONCURRENCY=2

# ---------------------------------------------------------------------------
# LLM (D-007: Qroq + mandatory validation layer)
# The key below was EXPOSED IN PLAINTEXT and MUST be rotated before use.
# ---------------------------------------------------------------------------
QROQ_API_KEY=REPLACE_ME_ROTATED_KEY
QROQ_BASE_URL=https://api.groq.com/openai/v1
QROQ_FAST_MODEL=openai/gpt-oss-20b
QROQ_REASONING_MODEL=openai/gpt-oss-120b
# Empty on purpose: this provider returned model_not_found for every embedding
# model id tried (probed 2026-10-06). RAG_EMBEDDING_MODE=qroq will not start
# until you point at a provider that embeds.
QROQ_EMBEDDING_MODEL=
RAG_EMBEDDING_MODE=none
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Bounded repair attempts after schema validation failure (D-007).
LLM_SCHEMA_REPAIR_ATTEMPTS=2
LLM_MAX_TOOL_ROUNDS=3
TOOL_OUTPUT_MAX_CHARS=8000
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 32-byte key, base64 or hex. Encrypts marketplace credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_ME

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# Section 34: keys masked before any telemetry leaves the process.
# Section 55: same keys masked in structured logs.
LOG_MASK_KEYS=sku,price,cost,supplier_cost,margin,unreleased_description,upc,ean,gtin,asin

# ---------------------------------------------------------------------------
# Observability (D-010: self-hosted Langfuse only)
# ---------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://REPLACE_ME.your-domain.internal
LANGFUSE_PUBLIC_KEY=REPLACE_ME
LANGFUSE_SECRET_KEY=REPLACE_ME

# ---------------------------------------------------------------------------
# Marketplace connectors
# Deferred past MVP (D-005). Values encrypted at rest with ENCRYPTION_KEY.
# ---------------------------------------------------------------------------
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Uploads (Section 49)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Cost control (Section 56)
# ---------------------------------------------------------------------------
LLM_COST_ALERT_ENABLED=true
LLM_MONTHLY_BUDGET_USD=0
# ---------------------------------------------------------------------------
# Password reset and invitations (D-017)
#
# Outbound mail is a port with one adapter. `outbox` writes each message to
# email_outbox and leaves sent_at NULL, because no provider is configured. Read
# queued messages with `python -m app.cli.outbox`; it refuses to run when
# ENVIRONMENT=production.
# ---------------------------------------------------------------------------
MAIL_DELIVERY=outbox
# Where the link in a message points. Required: a reset link built from the
# API's own host would send people to an internal hostname.
APP_BASE_URL=http://localhost:3000
RESET_TOKEN_TTL_MINUTES=60
# Cap on live reset tokens per account; older ones are invalidated on re-issue.
RESET_MAX_LIVE_TOKENS=3
# Separate budget from login throttling on purpose. Sharing one would let
# anyone lock a victim's account out of signing in.
RESET_MAX_REQUESTS=3
RESET_WINDOW_MINUTES=60
RESET_LOCKOUT_MINUTES=15
RESET_IP_MAX_REQUESTS=20
INVITATION_TOKEN_TTL_HOURS=72
INVITATION_MAX_PER_RECIPIENT=10
